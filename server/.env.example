# Secrets only — copy to .env and fill in. Never commit .env.
# Non-secret config (host, port, DB host, model) lives in config/{env}.ini

# Which config/{env}.ini to load (dev | staging | prod)
LOGSIGHT_ENV=dev

# Database password only — host/port/name/user come from config/{env}.ini
LOGSIGHT_DB_PASSWORD=logsight

# Anthropic direct API key (used when llm_backend = anthropic)
LOGSIGHT_ANTHROPIC_API_KEY=sk-ant-...

# Vertex AI backend (set llm_backend = vertex in config/{env}.ini to enable)
# Auth is via Google Application Default Credentials (gcloud auth application-default login)
LOGSIGHT_VERTEX_PROJECT_ID=my-gcp-project
LOGSIGHT_VERTEX_REGION=us-east5
